# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# ── Supabase (dedicated repentance101meet project — NOT BraidAppt) ─────
# DATABASE_URL = Transaction pooler (port 6543) — used at runtime on Vercel
# DIRECT_URL   = Direct connection (port 5432) — used for migrations
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Supabase Storage (avatars, chat attachments, recordings) ─────────
# Used on Vercel / local until S3_* is set. On the DreamHost VPS, Docker
# Compose sets S3_* to MinIO and these can stay blank.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Optional MinIO / S3 (DreamHost VPS compose sets these for you) ───
# S3_ENDPOINT="http://minio:9000"
# S3_PUBLIC_ENDPOINT="https://repentance101ministry.com"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_BUCKET="media"
# S3_REGION="us-east-1"

# ── Auth ─────────────────────────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── Admin seed (host account) ────────────────────────────────────────
ADMIN_EMAIL="norman@repentance101ministry.com"
ADMIN_PASSWORD="your-secure-admin-password"
ADMIN_NAME="Ministry Admin"

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Repentance 101"

# ── LiveKit Cloud (video rooms) ───────────────────────────────────────
LIVEKIT_URL="wss://your-project.livekit.cloud"
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
