generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipStatus {
  PENDING
  APPROVED
  DENIED
  REMOVED
}

enum ChannelType {
  PUBLIC
  PRIVATE
  GENERAL
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum MeetingKind {
  LIVESTREAM
  PRIVATE
}

enum MemberActivityType {
  JOINED
  MEMBERSHIP_APPROVED
  MEMBERSHIP_DENIED
  CHANNEL_REQUESTED
  CHANNEL_APPROVED
  CHANNEL_DENIED
  CHANNEL_REMOVED
  BLOCKED
  UNBLOCKED
  BLOCKED_MEETING
  UNBLOCKED_MEETING
  QUESTIONNAIRE_COMPLETED
  ONBOARDING_INVITE_SENT
  MEMBER_DELETED
  MEMBER_RESTORED
  MEMBER_PURGED
}

enum MembershipMessageType {
  TEXT
  ONBOARDING_INVITE
  SYSTEM
}

enum MemberDmRequestStatus {
  PENDING
  APPROVED
  DECLINED
  REMOVED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         Role          @default(MEMBER)
  status       AccountStatus @default(PENDING)
  questionnaireCompletedAt DateTime?
  questionnaireAnswers     Json?
  onboardingDueAt          DateTime?
  deletedAt                DateTime?
  purgeAt                  DateTime?
  deletedById              String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  deletedBy           User?                 @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  membersDeleted      User[]                @relation("UserDeletedBy")
  channelMemberships  ChannelMembership[]
  channelMessages     ChannelMessage[]
  meetingMessages     MeetingMessage[]
  meetingsCreated     Meeting[]             @relation("MeetingCreator")
  privateInvitations  Meeting[]             @relation("PrivateInvitee")
  blocksReceived      BlockList[]           @relation("BlockedUser")
  blocksIssued        BlockList[]           @relation("BlockedBy")
  meetingParticipants MeetingParticipant[]
  activityLogs        MemberActivityLog[]   @relation("MemberActivitySubject")
  activityActions     MemberActivityLog[]   @relation("MemberActivityActor")
  membershipThread    MembershipMessage[]   @relation("MembershipThread")
  membershipMessagesSent MembershipMessage[] @relation("MembershipMessageSender")
  dmRequestsSent      MemberDmRequest[]     @relation("DmRequestFrom")
  dmRequestsReceived  MemberDmRequest[]     @relation("DmRequestTo")
  dmBlocksIssued      MemberDmBlock[]       @relation("DmBlocker")
  dmBlocksReceived    MemberDmBlock[]       @relation("DmBlocked")
  dmMessagesSent      MemberDirectMessage[] @relation("DmSender")
  dmMessagesReceived  MemberDirectMessage[] @relation("DmRecipient")
}

model MemberActivityLog {
  id         String             @id @default(cuid())
  userId     String
  type       MemberActivityType
  occurredAt DateTime           @default(now())
  channelId  String?
  meetingId  String?
  reason     String?
  actorId    String?
  label      String?

  user    User     @relation("MemberActivitySubject", fields: [userId], references: [id], onDelete: Cascade)
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  actor   User?    @relation("MemberActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
}

model MembershipMessage {
  id           String                @id @default(cuid())
  threadUserId String
  senderId     String
  content      String                @db.Text
  attachments  Json?
  type         MembershipMessageType @default(TEXT)
  meetingId    String?
  readAt       DateTime?
  editedAt     DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  threadUser User     @relation("MembershipThread", fields: [threadUserId], references: [id], onDelete: Cascade)
  sender     User     @relation("MembershipMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  meeting    Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([threadUserId, createdAt])
}

model MemberDmRequest {
  id         String                @id @default(cuid())
  fromUserId String
  toUserId   String
  status     MemberDmRequestStatus @default(PENDING)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  fromUser User @relation("DmRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("DmRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

model MemberDmBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("DmBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("DmBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model MemberDirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  content     String    @db.Text
  attachments Json?
  readAt      DateTime?
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sender    User @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("DmRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

model BlockList {
  id          String    @id @default(cuid())
  userId      String
  blockedById String
  reason      String?
  createdAt   DateTime  @default(now())
  unblockedAt DateTime?

  user      User @relation("BlockedUser", fields: [userId], references: [id], onDelete: Cascade)
  blockedBy User @relation("BlockedBy", fields: [blockedById], references: [id], onDelete: Cascade)

  @@unique([userId, blockedById])
}

model Channel {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  type        ChannelType
  content     String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  memberships ChannelMembership[]
  messages    ChannelMessage[]
  activityLogs MemberActivityLog[]
}

model ChannelMembership {
  id          String           @id @default(cuid())
  userId      String
  channelId   String
  status      MembershipStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model ChannelMessage {
  id          String    @id @default(cuid())
  channelId   String
  userId      String
  content     String    @db.Text
  attachments Json?
  reactions   Json?
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Meeting {
  id            String        @id @default(cuid())
  title         String
  linkToken     String        @unique @default(cuid())
  kind          MeetingKind   @default(LIVESTREAM)
  status        MeetingStatus @default(SCHEDULED)
  recordingUrl  String?
  livekitRoom   String?
  createdById   String
  invitedUserId String?
  isOnboardingApproval Boolean @default(false)
  startedAt     DateTime?
  endedAt       DateTime?
  memberVideoEnabled Boolean @default(true)
  memberMicEnabled   Boolean @default(true)
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?
  purgeAt       DateTime?
  hostHiddenAt  DateTime?
  memberHiddenAt DateTime?

  createdBy    User                 @relation("MeetingCreator", fields: [createdById], references: [id])
  invitedUser  User?                @relation("PrivateInvitee", fields: [invitedUserId], references: [id])
  participants MeetingParticipant[]
  messages     MeetingMessage[]
  signals      MeetingSignal[]
  activityLogs MemberActivityLog[]
  membershipMessages MembershipMessage[]
}

model MeetingSignal {
  id         String   @id @default(cuid())
  meetingId  String
  fromUserId String
  toUserId   String?
  type       String
  payload    Json
  createdAt  DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
}

model MeetingParticipant {
  id         String   @id @default(cuid())
  meetingId  String
  userId     String
  blocked    Boolean  @default(false)
  handRaised Boolean  @default(false)
  handRaisedAt DateTime?
  reaction   String?
  reactionAt DateTime?
  joinedAt   DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

model MeetingMessage {
  id          String    @id @default(cuid())
  meetingId   String
  userId      String
  content     String    @db.Text
  attachments Json?
  replyToId   String?
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  meeting Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo MeetingMessage?  @relation("MeetingMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies MeetingMessage[] @relation("MeetingMessageReply")

  @@index([replyToId])
}

model MissedItDay {
  id        String   @id @default(cuid())
  weekStart DateTime @db.Date
  weekday   Int
  topic     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  links     MissedItLink[]

  @@unique([weekStart, weekday])
  @@index([weekStart])
}

model MissedItLink {
  id        String      @id @default(cuid())
  dayId     String
  title     String
  url       String
  sortOrder Int         @default(0)
  day       MissedItDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId, sortOrder])
}
