# Copy to `.env` on the VPS (never commit real secrets).
# docker compose reads this file for build args + runtime.
#
# Generate passwords with: openssl rand -hex 24
# (hex only — special characters can break DATABASE_URL)

# ── Public URLs (must match DNS pointed at this VPS) ─────────────────
NEXT_PUBLIC_APP_URL="https://repentance101ministry.com"
NEXTAUTH_URL="https://repentance101ministry.com"
NEXT_PUBLIC_APP_NAME="Repentance 101"

# ── Auth ─────────────────────────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# ── Host admin seed (only used if you run db:seed) ───────────────────
ADMIN_EMAIL="norman@repentance101ministry.com"
ADMIN_PASSWORD="your-secure-admin-password"
ADMIN_NAME="Ministry Admin"

# ── Local Postgres (in Docker on this VPS) ───────────────────────────
POSTGRES_PASSWORD="generate-with-openssl-rand-hex-24"

# ── MinIO (in Docker; Caddy serves /media, do not open port 9000) ────
MINIO_ROOT_USER="repentance101"
MINIO_ROOT_PASSWORD="generate-with-openssl-rand-hex-24"

# ── LiveKit Cloud (video) — keep until you self-host LiveKit ─────────
LIVEKIT_URL="wss://your-project.livekit.cloud"
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# ── Email (password reset via Resend) ────────────────────────────────
# RESEND_API_KEY=""
# EMAIL_FROM="Repentance 101 <noreply@repentance101ministry.com>"

# ── Off-site backups (restic → Cloudflare R2) ────────────────────────
# Create a free R2 bucket named repentance101-backups, then an API token
# with Object Read & Write. Store RESTIC_PASSWORD in a password manager.
# RESTIC_REPOSITORY="s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/repentance101-backups"
# RESTIC_PASSWORD="generate-with-openssl-rand-base64-32"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
