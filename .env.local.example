# Setup-only secrets for Repentance 101 (never commit real values)
# Copy to .env.local and fill in — this file stays in THIS repo only.

# One-time: create at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Optional: if you have multiple Supabase orgs
# SUPABASE_ORG_ID=

# Optional: only needed if Supabase project already exists and setup script can't infer password
# SUPABASE_DB_PASSWORD=

# Optional: only set if deploying under a specific Vercel team (NOT braid-appt)
# Leave blank to use your personal Vercel account
# VERCEL_SCOPE=
